<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="내비게이션 탐색 중..."
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:padding="16dp"
            android:background="#333333"/>

        <Switch
            android:id="@+id/swBoostEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="구간단속 보상가속 기능 켜기"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:enabled="false"/>

        <LinearLayout
            android:id="@+id/llBoostSettingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구간단속 보상가속 여유 속도"
                android:textColor="#DDDDDD"
                android:layout_marginBottom="8dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOffset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="50"
                    android:stepSize="1"
                    android:enabled="false"/>
                    
                <TextView
                    android:id="@+id/tvOffsetValue"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="0 km/h"
                    android:textColor="#FFFFFF"
                    android:gravity="end"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보상가속 모드 설정"
                android:textColor="#DDDDDD"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>
                
            <RadioGroup
                android:id="@+id/rgBoostMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rbBoostProgressive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:text="점진적 보상가속 (도달 시 중단)"
                    android:enabled="false"/>
                <RadioButton
                    android:id="@+id/rbBoostFixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:text="고정 보상가속 (강제 유지)"
                    android:enabled="false"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목표 평균속도 하향값 (km/h)"
                android:textColor="#DDDDDD"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderFakeDrop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="20"
                    android:stepSize="1"
                    android:enabled="false"/>
                    
                <TextView
                    android:id="@+id/tvFakeDropValue"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:gravity="end"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <Switch
            android:id="@+id/swDebugOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="디버그 오버레이 표시"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"
            android:enabled="false"/>

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="버전 정보"
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
